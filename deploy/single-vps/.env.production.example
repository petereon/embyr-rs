# Production environment for the single-VPS stack (docs/operations/single-vps-deploy.md).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production            # contains every secret; readable by the deploy user only
#   $EDITOR .env.production              # replace EVERY "REPLACE_ME"; scripts/update.sh refuses to run
#                                        # while any REPLACE_ME is left
#
# Format rules (docker compose env_file):
#   * KEY=value, one per line. No spaces around "=". Do not add trailing "# comments" to a value line.
#   * Values containing spaces, "<", ">" or "$" must be quoted: single quotes are fully literal.
#   * Never commit the filled file (deploy/single-vps/.env.production is in .gitignore).
#
# Full variable index for the server: /.env.example at the repo root and crates/embyr-server/src/config.rs.
# Values that docker-compose.prod.yml derives itself (do NOT set them here): DATABASE_URL,
# EMBYR_PUBLIC_BASE_URL (= https://console.$DOMAIN), EMBYR_ALLOW_PRIVATE_DSN_HOSTS (pinned false).

# ──────────────────────────────── edge / stack ────────────────────────────────
# Your registrable domain. api.$DOMAIN and console.$DOMAIN must have DNS A records -> this VPS.
DOMAIN=REPLACE_ME
# Let's Encrypt account email (expiry/problem notices).
ACME_EMAIL=REPLACE_ME

# Image: ghcr.io/<repository_owner>/embyr-server, immutable tags only (sha-<7 hex> or vX.Y.Z).
# Never "master". scripts/update.sh edits this line.
EMBYR_IMAGE=ghcr.io/petereon/embyr-server
EMBYR_IMAGE_TAG=REPLACE_ME

# ──────────────────────────────── secrets ────────────────────────────────
# Postgres password for the embyr role. Hex only, so it is safe inside the DATABASE_URL compose builds.
#   openssl rand -hex 24
# Fixed once the pgdata volume is initialised: changing it here later does NOT change the database.
POSTGRES_PASSWORD=REPLACE_ME

# Operator bearer token (suspend/activate, account bootstrap, /metrics, billing metering).
# The server refuses to start if it is shorter than 32 chars.
#   openssl rand -hex 32
EMBYR_ADMIN_KEY=REPLACE_ME

# AES-256-GCM key (exactly 64 hex chars) that encrypts customer DSNs, TOTP secrets and OIDC secrets
# in the system DB.
#   openssl rand -hex 32
#
# >>> BACK THIS UP NOW, OFFLINE, SEPARATELY FROM THE DATABASE BACKUPS <<<
# Put a copy in your password manager (1Password/Bitwarden entry "embyr ENCRYPTION_KEY (prod)") and
# ideally a second copy printed or on an offline USB stick. Do NOT store it in the same bucket as the
# pg_dump files, and do not email it to yourself.
# The database backup contains only ciphertext. If this key is lost: every stored customer DSN is
# unrecoverable (each customer must re-enter theirs), every admin user's TOTP secret is undecryptable
# (nobody can sign in; recovery codes do not help), and no restore can fix it.
# Rotation (dual-key window): docs/operations/secrets-manager-setup.md and ADR-018.
EMBYR_ENCRYPTION_KEY=REPLACE_ME

# ──────────────────────────────── email (invitations, password reset) ────────────────────────────────
# Required in production: with REQUIRE_SMTP=true the server refuses to start instead of silently
# dropping invite / reset emails. Any SMTP relay works (SES, Brevo, Resend, Postmark, ...).
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F).
#   port 465 implicit TLS:  smtps://USER:PASSWORD@smtp.example.com:465
#   port 587 STARTTLS:      smtp://USER:PASSWORD@smtp.example.com:587?tls=required
EMBYR_SMTP_URL='smtps://REPLACE_ME:REPLACE_ME@smtp.example.com:465'
EMBYR_EMAIL_FROM='Embyr <no-reply@REPLACE_ME>'
EMBYR_REQUIRE_SMTP=true
# Invite emails only contain a relative link (/admin/?invite=TOKEN). The operator bootstrap call also
# returns the token, so you can always hand it over yourself: see the runbook.

# ──────────────────────────────── proxy / browsers ────────────────────────────────
# Exactly ONE trusted reverse proxy (Caddy) sits in front of :9090, and the Caddyfile makes
# X-Forwarded-For a single entry. Keep this 1 unless the Caddyfile changes with it. 0 would key every
# sign-in throttle on Caddy's container IP (one shared bucket for the whole internet); a value that is
# too high lets clients spoof their IP.
EMBYR_TRUSTED_PROXY_HOPS=1

# Browser origins allowed to call the data plane on api.$DOMAIN (gRPC-Web / REST / BrowserChannel
# from web apps). Comma-separated exact origins, no trailing slash. Empty = deny all (native gRPC
# clients and the console are unaffected). Example: https://app.partner.example,https://staging.partner.example
EMBYR_CORS_ALLOWED_ORIGINS=

# ──────────────────────────────── process / sizing (one 2 vCPU / 4 GB box) ────────────────────────────────
RUST_LOG=info

# Shutdown: after SIGTERM /healthz turns 503 and in-flight requests get GRACE seconds. DELAY only helps
# when a load balancer must deregister the instance first; there is none here (single replica, Caddy
# retries on its own), so 0. docker-compose.prod.yml stop_grace_period (45 s) must stay above DELAY+GRACE.
EMBYR_SHUTDOWN_GRACE_SECS=25
EMBYR_SHUTDOWN_DELAY_SECS=0

# Postgres pools (ADR-079; formula in docs/operations/topology.md). The system DB has
# max_connections=50 (docker-compose.prod.yml): one replica x 10 + backups/psql headroom fits easily.
# Tenant/listener pools connect to CUSTOMER databases (not this Postgres); each served project costs
# TENANT + LISTENER + 1 connections on the customer's side, so keep these small for beta.
EMBYR_SYSTEM_DB_MAX_CONNECTIONS=10
EMBYR_TENANT_DB_MAX_CONNECTIONS=5
EMBYR_TENANT_DB_ACQUIRE_TIMEOUT_SECS=5
EMBYR_LISTENER_DB_MAX_CONNECTIONS=2
EMBYR_LISTENER_DB_ACQUIRE_TIMEOUT_SECS=5

# Per-project request limiter (token bucket). Default is fine for a beta; lower it to protect a small box.
# EMBYR_RATE_LIMIT_RPS=1000.0

# ──────────────────────────────── Stripe billing: LEAVE UNSET UNTIL BILLING IS ENABLED ────────────────────────────────
# Exactly what the server does when these are unset (read from config.rs / main.rs / handlers):
#   * Billing is "unwired": a placeholder key is used and no Stripe call is made at startup beyond one
#     probe, which fails and logs a WARN ("startup probe failed: stripe API unreachable or
#     misconfigured (soft failure)") on every boot. Expected and harmless.
#   * POST /admin/v1/webhooks/stripe is NOT mounted (404). Stripe cannot reach us, nothing to secure.
#   * The console's checkout/portal buttons (POST /admin/v1/billing/{checkout,portal}_session) are NOT
#     disabled: because EMBYR_PUBLIC_BASE_URL is set (needed for email links), they get as far as Stripe
#     and answer 502 Bad Gateway (or 500 on a DB error). Do not offer paid plans to beta users yet.
#   * GET /admin/v1/billing only reads the system DB (no Stripe reference in its handler); the background
#     cap checker keeps running regardless. /billing/subscription was not traced; treat it as untested.
# When you enable billing, set BOTH of these (setting only STRIPE_SECRET_KEY refuses startup). Use
# single quotes; the signing secret comes from the Stripe webhook endpoint
# https://console.$DOMAIN/admin/v1/webhooks/stripe (already allowlisted in the Caddyfile).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SIGNING_SECRET=
# STRIPE_PUBLISHABLE_KEY=
