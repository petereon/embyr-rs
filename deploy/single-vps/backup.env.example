# Config for scripts/backup.sh, scripts/restore.sh --latest and scripts/check.sh.
# Shell syntax (it is sourced). Copy to backup.env next to docker-compose.prod.yml, chmod 600.
#   cp backup.env.example backup.env && chmod 600 backup.env
#
# rclone remote:path. Create the remote once with `rclone config` as the deploy user.
# STRONGLY recommended: an rclone *crypt* remote layered on top of the S3/B2 remote, so the storage
# provider only ever sees ciphertext (the dump holds password hashes and encrypted DSNs).
# Never put EMBYR_ENCRYPTION_KEY or .env.production in this bucket.
BACKUP_REMOTE="b2crypt:embyr-prod"

# Retention counts files, not days, so a silent backup outage can never prune your last good dumps.
KEEP_DAILY=7
KEEP_WEEKLY=4

# Local staging copies (kept ~3 days for fast restores). Must be on the VPS disk.
# BACKUP_DIR="/opt/embyr/backups"

# Optional dead-man's-switch (healthchecks.io or similar, free tier): the script GETs this URL on
# success and "$PING_URL/fail" on failure; the service alerts you when pings stop arriving.
# PING_URL="https://hc-ping.com/REPLACE_WITH_YOUR_UUID"

# scripts/check.sh heartbeat (separate check in the same service, so a dead VPS is noticed).
# CHECK_PING_URL="https://hc-ping.com/REPLACE_WITH_ANOTHER_UUID"
