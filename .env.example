# embyr-rs environment variables — source of truth across all 3 binaries.
# See README.md "Configuration" for the 3-binary overview. Per-field detail
# lives in each binary's own config.rs rustdoc (paths noted per section).
#
# Required vars have no default and MUST be set. Optional vars show their
# default in [brackets]. Never commit a real .env — copy this file to .env
# and fill in real values, which .gitignore already excludes.

# ============================================================================
# embyr-server (crates/embyr-server/src/config.rs — ServerConfig)
# gRPC :8080, REST/gRPC-Web :8081, Admin HTTP :9090
# ============================================================================

# --- Required ---
DATABASE_URL=                          # Postgres DSN for the system DB
EMBYR_ADMIN_KEY=                       # Non-empty Bearer token for operator routes
EMBYR_ENCRYPTION_KEY=                  # Exactly 64 hex chars (32-byte AES-256-GCM key)

# --- Admin-key / encryption-key rotation (optional, ADR-018 §5/§6) ---
EMBYR_ADMIN_KEY_PREVIOUS=              # Opens an admin-token rotation window
EMBYR_ENCRYPTION_KEY_PREVIOUS=         # Opens a decrypt-rotation window (64 hex chars)

# --- Secrets-manager-sourced admin/encryption keys (optional, ADR-018) ---
# Exactly one of {plain var, _AWS_SECRET_ARN, _GCP_SECRET_NAME} may be set
# per logical secret; setting more than one is a startup error.
EMBYR_ADMIN_KEY_AWS_SECRET_ARN=
EMBYR_ADMIN_KEY_GCP_SECRET_NAME=
EMBYR_ADMIN_KEY_PREVIOUS_AWS_SECRET_ARN=
EMBYR_ADMIN_KEY_PREVIOUS_GCP_SECRET_NAME=
EMBYR_ENCRYPTION_KEY_AWS_SECRET_ARN=
EMBYR_ENCRYPTION_KEY_GCP_SECRET_NAME=
EMBYR_ENCRYPTION_KEY_PREVIOUS_AWS_SECRET_ARN=
EMBYR_ENCRYPTION_KEY_PREVIOUS_GCP_SECRET_NAME=
EMBYR_GCP_ACCESS_TOKEN=                # Required when any *_GCP_SECRET_NAME above is set

# --- Ports / logging (optional) ---
GRPC_PORT=8080                         # [8080] gRPC listener port
REST_PORT=8081                         # [8081] REST/gRPC-Web listener port
ADMIN_PORT=9090                        # [9090] Admin HTTP listener port
RUST_LOG=info                          # [info] Tracing level filter

# --- Rate limiting (optional) ---
EMBYR_RATE_LIMIT_RPS=1000.0            # [1000.0] Token bucket capacity and refill rate

# --- TLS (optional, both-or-neither, ADR firestore-tls-support) ---
EMBYR_TLS_CERT_PATH=                   # [unset = plaintext] PEM cert path, shared by all 3 listeners
EMBYR_TLS_KEY_PATH=                    # [unset = plaintext] PEM key path

# --- CORS (optional, cors-origin-policy finding #21) ---
EMBYR_CORS_ALLOWED_ORIGINS=            # [empty = deny-all] Comma-separated browser origins for :8081

# --- Stripe billing (optional, ADR-021 / US-203) ---
STRIPE_SECRET_KEY=                     # [unset = billing unwired]
STRIPE_WEBHOOK_SIGNING_SECRET=         # Required if STRIPE_SECRET_KEY is set
STRIPE_PUBLISHABLE_KEY=                # [unset] Reserved for a future client-side Stripe Elements step

# --- Background task intervals/retention (optional) ---
EMBYR_CAP_CHECK_INTERVAL_SECS=30       # [30] Cumulative cap-check background task interval (ADR-020)
EMBYR_TRANSACTION_SWEEP_INTERVAL_SECS=300  # [300] TransactionSweeper interval (ADR-054 §D7)
EMBYR_TRANSACTION_RETENTION_DAYS=30    # [30] TransactionSweeper purge retention window
EMBYR_SOFT_DELETE_SWEEP_INTERVAL_SECS=3600 # [3600] SoftDeletePurgeSweeper interval (ADR-073 §D3)
EMBYR_SOFT_DELETE_GRACE_DAYS=7         # [7] SoftDeletePurgeSweeper grace window (ADR-073 §D3)

# --- Postgres pool sizing/timeouts (optional, ADR-079) ---
EMBYR_SYSTEM_DB_MAX_CONNECTIONS=5      # [5]
EMBYR_TENANT_DB_MAX_CONNECTIONS=5      # [5]
EMBYR_TENANT_DB_ACQUIRE_TIMEOUT_SECS=5 # [5]
EMBYR_LISTENER_DB_MAX_CONNECTIONS=2    # [2]
EMBYR_LISTENER_DB_ACQUIRE_TIMEOUT_SECS=5   # [5]

# ============================================================================
# embyr-agent (crates/embyr-agent/src/config.rs — AgentConfig)
# Customer-VPC agent binary, gRPC listener default :9191
# ============================================================================

# --- Required ---
EMBYR_AGENT_DB_DSN=                    # Postgres DSN for the customer database
EMBYR_AGENT_PROJECT_ID=                # Project identifier this agent instance serves
EMBYR_AGENT_CERT=                      # Path to PEM-encoded server TLS certificate
EMBYR_AGENT_KEY=                       # Path to PEM-encoded server TLS private key
EMBYR_AGENT_CA=                        # Path to PEM-encoded CA cert used to verify client certs (mTLS)

# --- Optional ---
EMBYR_AGENT_LISTEN_ADDR=0.0.0.0:9191   # [0.0.0.0:9191] gRPC server listen address
EMBYR_AGENT_MAX_CONNS=25               # [25] Maximum Postgres connection pool size
EMBYR_AGENT_LOG_LEVEL=info             # [info] Tracing subscriber log level
EMBYR_AGENT_SHUTDOWN_TIMEOUT_SECS=30   # [30] Graceful-shutdown drain timeout
EMBYR_AGENT_TRANSACTION_RETENTION_DAYS=30  # [30] Terminal transaction row retention window

# ============================================================================
# embyr-db-prep (crates/embyr-db-prep/src/config.rs — DbPrepConfig)
# One-shot customer-DB provisioning/backfill tool
# ============================================================================

# --- Required ---
EMBYR_DB_PREP_DSN=                     # Elevated DSN to apply migrations/customer/ + run GRANT. NEVER logged.

# --- Optional ---
EMBYR_DB_PREP_DML_ROLE_DSN=            # [unset] DML-only role's DSN, used once to self-discover role name. NEVER logged.
EMBYR_DB_PREP_BACKFILL_BATCH_SIZE=1000 # [1000] Rows per backfill batch (ADR-080)
EMBYR_DB_PREP_BACKFILL_THROTTLE_MS=50  # [50] Milliseconds slept between backfill batches (ADR-080)
