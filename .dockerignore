# Build artifacts — excluded to minimise Docker build context and avoid stale binaries
target/
# ...except the pre-built embyr-agent musl release binary the agent CI job's
# Dockerfile COPYs in (see ADR-074) — un-exclude just that path.
!target/x86_64-unknown-linux-musl/
!target/x86_64-unknown-linux-musl/release/
!target/x86_64-unknown-linux-musl/release/embyr-agent

# Version control history
.git/
.gitignore

# Documentation (not needed at compile time)
docs/

# Tests (not needed in the production image)
tests/

# Editor / IDE state
.vscode/
.idea/

# nWave / DES tooling (project management files)
.nwave/

# macOS metadata
.DS_Store
