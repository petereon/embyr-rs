          "criteria": [
            "GET /metrics on :9090 returns 200 with Content-Type: text/plain; version=0.0.4",
            "Requires operator Bearer auth — 401 without it",
            "PrometheusHandle installed via OnceLock before any server bind",
            "metrics = 0.23 and metrics-exporter-prometheus = 0.15 in Cargo.toml"
          ],
          "test_file": "tests/observability/acceptance/obs01_prometheus_endpoint.rs",
          "scenario_name": "metrics_endpoint_returns_200_with_prometheus_content_type"
        }
      ]
    },
